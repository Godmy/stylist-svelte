{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*",
    "src/global.d.ts",
    "modules/design-system/theme/**/*",
    "modules/design-system/typography/**/*",
    "modules/design-system/layout/**/*",
    "modules/design-system/localization/**/*",
    "modules/design-system/svg/**/*",
    "modules/interaction/animation/**/*",
    "modules/interaction/button/**/*",
    "modules/interaction/control/**/*",
    "modules/interaction/input/**/*",
    "modules/interaction/form/**/*",
    "modules/interaction/calendar/**/*",
    "modules/interaction/file/**/*",
    "modules/interaction/search/**/*",
    "modules/interaction/menu/**/*",
    "modules/interaction/navigation/**/*",
    "modules/interaction/dialog/**/*",
    "modules/information/list/**/*",
    "modules/information/tree/**/*",
    "modules/information/table/**/*",
    "modules/information/chart/**/*",
    "modules/information/image/**/*",
    "modules/information/audio/**/*",
    "modules/information/video/**/*",
    "modules/information/notification/**/*",
    "modules/customer/auth/**/*",
    "modules/customer/user/**/*",
    "modules/customer/chat/**/*",
    "modules/customer/social/**/*",
    "modules/global/commerce/**/*",
    "modules/global/product/**/*",
    "modules/management/management/**/*",
    "modules/management/marketing/**/*",
    "modules/customer/landing/**/*",
    "modules/management/portfolio/**/*",
    "modules/management/science/**/*",
    "modules/architecture/graph/**/*",
    "modules/architecture/erd/**/*",
    "modules/architecture/idef-zero/**/*",
    "modules/architecture/workspace/**/*",
    "modules/architecture/canvas/**/*",
    "modules/architecture/presentation/**/*",
    "modules/architecture/webgl/**/*",
    "modules/sandbox/domain/**/*",
    "modules/sandbox/token/**/*",
    "modules/sandbox/server/**/*",
    "modules/business/travel/booking/**/*",
    "modules/business/travel/travel-commerce/**/*",
    "modules/business/travel/travel-admin/**/*",
    "modules/business/sakartvelo/tea-commerce/**/*",
    "modules/global/geo/**/*",
    "modules/business/wbd/**/*",
    "modules/business/spanish/**/*",
