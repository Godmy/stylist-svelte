{
	"name": "stylist-svelte",
	"version": "1.0.2",
	"description": "A comprehensive Svelte 5 UI component library",
	"type": "module",
	"author": "Godmy & AI-Team",
	"license": "MIT",
	"sideEffects": [
		"**/*.css"
	],
	"packageManager": "yarn@4.6.0",
	"keywords": [
		"stylist",
		"svelte",
		"ai",
		"svelte5",
		"ui",
		"components",
		"design-system",
		"design-tokens"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Godmy/stylist-svelte.git"
	},
	"bugs": {
		"url": "https://github.com/Godmy/stylist-svelte/issues"
	},
	"homepage": "https://github.com/Godmy/stylist-svelte#readme",
	"scripts": {
		"modules:prepare": "node scripts/prepare-module-sources.mjs",
		"dev": "vite dev",
		"build": "node scripts/package-modules.mjs && node scripts/publint-package.mjs",
		"build:site": "node scripts/generate-lib-source-mirror.mjs && vite build && node scripts/write-cloudflare-assets-ignore.mjs",
		"ci:pipeline": "yarn lint && yarn test:package-source && yarn test:unit && yarn build",
		"preview": "vite preview",
		"package": "node scripts/package-modules.mjs",
		"check:package-source": "node scripts/check-package-source.mjs",
		"package:watch": "node scripts/package-modules.mjs --watch",
		"tsc": "tsc --noEmit",
		"prepublishOnly": "yarn build",
		"check": "svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js --watch",
		"validate": "yarn lint && yarn tsc && yarn check",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:package-source": "node --test scripts/check-package-source.test.mjs scripts/prepare-module-sources.test.mjs scripts/assemble-package-source.test.mjs scripts/package-modules.test.mjs scripts/public-sandbox.test.mjs scripts/verify-public-build.test.mjs scripts/pre-push-hook.test.mjs scripts/check-public-boundary.test.mjs scripts/check-package-tarball.test.mjs",
		"hooks:install": "git config core.hooksPath .githooks",
		"verify:public-build": "node scripts/verify-public-build.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"clean": "node -e \"const fs=require('node:fs'); ['dist','.svelte-kit','node_modules/.vite'].forEach((path)=>fs.rmSync(path,{recursive:true,force:true}));\"",
		"audit": "yarn audit",
		"depcheck": "depcheck",
		"gate": "node scripts/stylist-gate.mjs",
		"check:package-tarball": "node scripts/check-package-tarball.mjs"
	},
	"exports": {
		"./*": "./dist/*",
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!scripts/**",
		"!dist/**/.git",
		"!dist/geo/**",
		"!dist/wbd/**",
		"!dist/booking/**",
		"!dist/travel-commerce/**",
		"!dist/travel-admin/**",
		"!dist/auth/**",
		"!dist/user/**",
		"!dist/chat/**",
		"!dist/social/**",
		"!dist/commerce/**",
		"!dist/product/**",
		"!dist/management/**",
		"!dist/marketing/**",
		"!dist/landing/**",
		"!dist/portfolio/**",
		"!dist/science/**",
		"!dist/spanish/**",
		"!dist/farm/**",
		"!dist/index.full.*",
		"!dist/**/*.story.*",
		"!dist/**/index.story.svelte",
		"!dist/**/index.story.svelte.d.ts",
		"!dist/**/story-*.svelte",
		"!dist/**/story-*.svelte.d.ts",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/server/**"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@testing-library/svelte": "^5.2.8",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"baseline-browser-mapping": "^2.9.19",
		"depcheck": "^1.4.7",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"jsdom": "^29.0.1",
		"madge": "^8.0.0",
		"postcss": "^8.4.49",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.15",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"svelte-preprocess": "^6.0.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.1.7",
		"vitest": "^3.2.4",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"marked": "^17.0.0",
		"shiki": "^3.15.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
